# Crelume — environment template
# Copy to .env for local development: cp .env.example .env
# Never commit .env.

# ── Django core ────────────────────────────────────────────────────────────
# manage.py uses crelume.settings.dev by default and WSGI/ASGI use
# crelume.settings.prod. Uncomment only if you need to force a module.
# DJANGO_SETTINGS_MODULE=crelume.settings.prod
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=
SITE_URL=http://localhost:8080

# ── Production database: Supabase Postgres ─────────────────────────────────
# Supabase dashboard → Project Settings → Database → Connection string.
# Use a pooler string (transaction pooler :6543 or session pooler :5432).
# Required when DJANGO_SETTINGS_MODULE=crelume.settings.prod.
DATABASE_URL=
DATABASE_SSL_REQUIRE=1
DB_CONN_MAX_AGE=600
# Transaction pooler (:6543) does not support server-side cursors.
DB_DISABLE_SERVER_SIDE_CURSORS=1

# ── Email: Resend (https://resend.com) ─────────────────────────────────────
# Required in production. Verify your sending domain in Resend first, then
# set DEFAULT_FROM_EMAIL to an address on that domain.
# Local development prints email to the console and ignores RESEND_API_KEY.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Crelume <no-reply@crelume.com>
CONTACT_EMAIL=hello@crelume.com
TICKET_EMAIL_SUBJECT=Your Crelume tickets
EMAIL_TIMEOUT=20
# Optional: use SMTP locally instead of the console backend.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1

# ── Paystack (https://dashboard.paystack.com/#/settings/developers) ──────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=NGN
# Optional. Defaults to https://<host>/payments/paystack/callback/
PAYSTACK_CALLBACK_URL=

# ── Google / GitHub OAuth ─────────────────────────────────────────────────
# Google: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: https://<host>/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers
#   Authorization callback URL: https://<host>/accounts/github/login/callback/
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── reCAPTCHA v2 "I'm not a robot" checkbox ────────────────────────────────
# https://www.google.com/recaptcha/admin/create
# The values below are Google's public test keys (always pass). Replace them.
# Production fails fast if test keys are still in place.
RECAPTCHA_PUBLIC_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_PRIVATE_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# ── HTTPS / security (production defaults) ─────────────────────────────────
# DJANGO_BEHIND_PROXY=1
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
# DJANGO_SECURE_HSTS_PRELOAD=0

# ── Behaviour ─────────────────────────────────────────────────────────────
TICKET_MAX_QUANTITY=10
ACCOUNT_EMAIL_VERIFICATION=mandatory
ORDERS_LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
